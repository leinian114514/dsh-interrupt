{
  "name": "dsh-interrupt",
  "version": "0.1.0",
  "description": "插话旁路：turn 运行时用侧栏输入框发一句话，绕过客户端会丢消息的发送队列，在下一步注入给你",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": ["deepseek", "deepseek-harness", "dsh", "dsh-plugin", "steer", "interrupt"],
  "license": "MIT",
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-slots"]
    }
  }
}
